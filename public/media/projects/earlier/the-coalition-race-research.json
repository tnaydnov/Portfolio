  "oneLiner": "A policy-driven C++ simulation of agents, offers and coalition formation.",
  "summary": "A coursework simulation represents a 120-mandate parliament as a weighted graph. Agents choose neighboring parties to approach, parties collect and evaluate offers, and each joining party extends a coalition and creates a new agent. JSON snapshots make every simulation step inspectable.",
  "stack": [
    "C++11",
    "Strategy interfaces",
    "Rule of Five",
    "nlohmann JSON",
    "Make / g++",
    "Python",
    "NetworkX / Matplotlib"
  ],
  "capabilityGroups": [
    {
      "title": "Separate whom to approach from whom to join",
      "summary": "Agent selection policies consider edge weight or party mandates. Party join policies choose the last offer or the offering coalition with the largest mandate total.",
      "details": [
        "Policies are selected from JSON configuration.",
        "Parties progress through Waiting, CollectingOffers and Joined states."
      ],
