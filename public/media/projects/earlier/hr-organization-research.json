    {
      "title": "Schedule around actual constraints",
      "summary": "Employees submit availability; HR assigns qualified staff to stores and roles, confirms shifts and manages weekly schedules.",
      "details": [
        "Role/store certification checks before shift assignment.",
        "No two shifts on a day and a six-shift weekly limit in the controller.",
        "Shift confirmation requires a shift manager.",
        "Employee removal is refused when future shifts remain."
