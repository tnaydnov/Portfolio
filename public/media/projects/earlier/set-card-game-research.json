  "decisions": [
    {
      "title": "Separate selection from validation",
      "implementation": "Player threads collect token selections and enqueue their ID; the dealer owns rule checking, card removal and the point/penalty response.",
      "whyItMatters": "This makes the contention visible: multiple players can refer to the same cards, but validation must coordinate with card replacement. This explanation is inferred from the implementation.",
      "citations": [
        {
          "file": "src/main/java/bguspl/set/ex/Player.java",
          "line": 120,
          "endLine": 188,
          "url": "https://github.com/tnaydnov/Set_Card_Game/blob/cf44b52616b0b8862338e134e05b029f5de9d7b4/src/main/java/bguspl/set/ex/Player.java#L120-L188"
        },
